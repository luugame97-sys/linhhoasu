  "30001001": {
    "cn": "如果遇到用不上的装备可以出售掉，还能获得一些<font color=#dc6302>银币</font>和<font color=#dc6302>修为</font>"
  },
  "30001002": {
    "cn": "修炼时，也要多多关注自己哦"
  },
  "30001003": {
    "cn": "寻常装备能提升你的<font color=#dc6302>生命、攻击、防御</font>等，但有些装备还有其他效用，可千万不要错过了"
  },
  "30001004": {
    "cn": "比如？比如<font color=#dc6302>连击、暴击、击晕......</font>嘻嘻，还有很多惊喜呢！不要心急"
  },
  "30001005": {
    "cn": "修行之人，总是要外出寻找机缘的，道友可要小心哦"
  },
  "30001006": {
    "cn": "你的雷劫已经来了！<font color=#dc6302>渡劫</font>后将去往更高的境界，快去准备吧！"
  },
  "30001007": {
    "cn": "修为达到上限并且完成渡劫任务后，就可以进行渡劫啦！"
  },
  "30001008": {
    "cn": "好厉害呀，修为提升这么快！和我去参加<font color=#dc6302>武道会</font>吧！"
  },
  "30001009": {
    "cn": "在这里你可以和各路道友进行比武，可以获得<font color=#dc6302>大量银币</font>哦！"
  },
  "30001010": {
    "cn": "哇，<font color=#dc6302>法相</font>已经开启了，快去看看吧！"
  },
  "30001011": {
    "cn": "修炼这么久，你一定累了吧，快来开启<font color=#dc6302>自动打怪</font>，解放双手"
  },
  "30001012": {
    "cn": "可以根据自己的需求选择条件，选择完毕后就开始自动打怪吧！"
  },
  "30001013": {
    "cn": "查看<font color=#dc6302>玩法说明</font>，发现更多奥秘！"
  },
  "30001014": {
    "cn": "神兵可以进行<font color=#dc6302>强化升级</font>哦，强化后提供更多属性"
  },
  "30001015": {
    "cn": "神兵<font color=#dc6302>20级</font>后可以锻造出一种技能，大大提高战斗能力！不过只有<font color=#dc6302>史诗品质及以上</font>的神兵才能锻造技能哦"
  },
  "30001016": {
    "cn": "修仙路漫漫，没有一把强力神兵可不行，快看看获得的<font color=#dc6302>神兵</font>吧！"
  },
  "30001017": {
    "cn": "点击魂玉图标可查看信息面板，了解魂玉更多信息，也可从这里进行镶嵌/卸下操作"
  },
  "30001018": {
    "cn": "恭喜你开启了虚天宝殿，我来带领道友前往吧"
  },
  "30001019": {
    "cn": "挑战到一定层数后，可以选择宝殿加成哦，为道友通关助力"
  },
  "30001020": {
    "cn": "道友的本命法宝是什么？快去挑选吧"
  },
  "30001021": {
    "cn": "为名忙，为利忙，忙里偷闲钓个鱼去~"
  },
  "30001022": {
    "cn": "放入鱼篓中的鱼可以给道友提供属性加成，鱼的<font color=#dc6302>重量越大，属性越好</font>哦"
  },
  "30001023": {
    "cn": "对当前订单不满意？使用刷新券刷到满意为止"
  },
  "30001024": {
    "cn": "消耗天赋点数，点亮天赋节点~"
  },
  "30001025": {
    "cn": "命格图鉴中收录了所有命格的信息，了解这些信息可以帮助道友更好的做出选择~"
  },
  "30001026": {
    "cn": "拥有多个同名坐骑，可进行<font color=#dc6302>升星</font>，坐骑升星可<font color=#dc6302>激活/升级技能</font>"
  },
  "30001027": {
    "cn": "消耗同名武魂进行升星，可提升武魂技能效果和等级上限哦~"
  },
  "30001028": {
    "cn": "设置心愿单可提高武魂召唤概率，道友快来试试吧~"
  },
  "30001029": {
    "cn": "点击图标查看技能效果，搭配出最强的元素技能组合吧~"
  },
  "30001030": {
    "cn": "武魂能为道友带来大量的<font color=#dc6302>元素效果</font>的加持，在属性面板可查看所有上阵武魂提供的属性总和哦~"
  },
  "30001031": {
    "cn": "在阵容中可设置出战的武魂卡组哦~"
  },
  "30001032": {
    "cn": "点击卡面可招募该英雄出战"
  },
  "30001033": {
    "cn": "扩建可解锁新的英雄站位"
  },
  "30001034": {
    "cn": "点击刷新可重新抽取英雄"
  },
  "30001035": {
    "cn": "就是这样，继续招募更多英雄~"
  },
  "30001036": {
    "cn": "点击英雄，可查看信息面板"
  },
  "30001037": {
    "cn": "部分英雄会提供作用于队友的光环效果，合理搭配阵容和招募策略是致胜的不二法门！"
  },
  "30001038": {
    "cn": "挑战排名高于自己的对手，获胜后可取代他的位置哦~"
  },
  "30001039": {
    "cn": "附灵可增加元素效果抗性"
  },
  "30001040": {
    "cn": "一键附灵可将所有元素抗性均匀升级，省时省心省力，快来试试吧~"
  },
  "30001041": {
    "cn": "想要获得额外的灵值点吗？去其他道友那里窃一点吧，修仙之人的事怎么能叫偷呢？"
  },
  "30001042": {
    "cn": "血脉品阶达到条件后可以解锁<font color=#dc6302>战斗技能</font>哦，血脉触发技能时将替换主角普通攻击"
  },
  "30001043": {
    "cn": "仔细阅读教程，很多疑问可以从这找到答案哦~"
  },
  "30001044": {
    "cn": "每种颜色星星的星级不同，总星级影响血脉品阶。品阶提高后可以解锁或升级血脉技能哦"
  },
  "30001045": {
    "cn": "通过合成可以获得更高品质的血脉，投入越多血脉成功率越高"
  },
  "30001046": {
    "cn": "不知道是哪位道友把物资遗落在街上了,那我们就笑纳喽~"
  },
  "30001047": {
    "cn": "使用黄金瞳可以看破商品品质，听说拥有黄金面具秘宝后还能看穿商品类型！"
  },
  "30001048": {
    "cn": "这组里有史诗品质的商品，那就选它了"
  },
  "30001049": {
    "cn": "在这里可使用随机神兵箱兑换伴生神兵"
  },
  "30001050": {
    "cn": "伴生神兵可帮助道友大幅增加生存能力，一定要好好培养~"
  },
  "30001051": {
    "cn": "道友在这里可重新选择职业和性别，转职后天赋将重置并返还所有点数"
  },
  "30001052": {
    "cn": "在这里可以调整出战所需的卡组，注意部分费用的妖灵有携带张数的限制哦"
  },
  "30001053": {
    "cn": "点击图标即可购买妖灵"
  },
  "30001054": {
    "cn": "这张也不错让我们买一下"
  },
  "30001055": {
    "cn": "继续豪横拿下"
  },
  "30001056": {
    "cn": "再买一张，这个妖灵就可以升级了"
  },
  "30001057": {
    "cn": "一切准备就绪，让我们进入战斗吧"
  },
  "30001058": {
    "cn": "相同阵营的妖灵可以获得强力羁绊，帮助道友奠定省局~"
  },
  "30001059": {
    "cn": "消耗斗币还可以给商店购买经验升级，升级后可扩张上阵人数，同时也可刷新更多更好的商品"
  },
  "30001060": {
    "cn": "这一批商品不是很好，让我们刷新一下吧"
  },
  "30001061": {
    "cn": "这次刷新出法器了，快点击购买吧"
  },
  "30001062": {
    "cn": "点击商品放大镜可查看信息，点击背包中的妖灵或法器也可唤起信息面板"
  },
  "30001063": {
    "cn": "一切就绪 可以开打了"
  },
  "30001064": {
    "cn": "点击这里可以查看自己已经拥有的法器信息，合理安排出战阵容"
  },
  "30001065": {
    "cn": "相伴的时间总是这么短暂，还有很多策略和技巧需要道友自己摸索\n现在将阵容调整到最佳状态，然后继续游戏吧"
  },
  "30001066": {
    "cn": "可以切换出手策略来调整妖灵出战回合数，每个战位对应的回合数不一样，按需调整哦"
  },
  "30001067": {
    "cn": "升级妖灵可以提升属性和技能等级哦，到一定等级后还能觉醒呢！\n碎片不足的话，快去召唤看看吧"
  },
  "30001068": {
    "cn": "点击这里查看战斗方案2"
  },
  "30001069": {
    "cn": "点击即可切换到该战斗方案，不同战斗方案间装备是独立的哦~"
  },
  "30001070": {
    "cn": "在这里可设置方案的自定义名称方便辨认哦~"
  },
  "30001071": {
    "cn": "神兵现在可以淬火了，快点进来看看吧"
  },
  "30001072": {
    "cn": "在这里可以查看所有淬火可带来的技能"
  },
  "30001073": {
    "cn": "选择辅助材料可必定淬出指定元素的效果哦"
  },
  "30001074": {
    "cn": "准备好了就试试吧"
  },
  "30001075": {
    "cn": "道友即将拥有<font color=#dc6302>神话武魂</font>了！真是可喜可贺！\n下面就由我来为您讲解下<font color=#dc6302>进阶规则</font>吧"
  },
  "30001076": {
    "cn": "<font color=#dc6302>太初魂核</font>是<font color=#dc6302>进阶神话武魂</font>和<font color=#dc6302>神话武魂升星</font>的必备材料"
  },
  "30001077": {
    "cn": "神话武魂需要<font color=#dc6302>未养成</font>的<font color=#dc6302>传说本体武魂</font>作为材料~\n悄悄告诉你已养成的传说武魂可<font color=#dc6302>重置</font>为未养成的状态哦"
  },
  "30001078": {
    "cn": "还需要一些<font color=#dc6302>任意传说武魂</font>作为材料，这里既可以填本体又可以填其他武魂"
  },
  "30001079": {
    "cn": "也可以使用<font color=#dc6302>一键填入</font>功能，快速填入材料哦~\n需要注意的就这么多，道友快去试试吧"
  },
  "30001080": {
    "cn": "画中阁已开启，道友可于画境之中随心构筑，共谱桃园之境"
  },
  "30001081": {
    "cn": "连通技能节点可激活强力技能，技能等级受上阵灵枢等级影响"
  },
  "30001082": {
    "cn": "若灵枢连通惩罚节点，则该灵阵所有灵枢都将受到对应的等级削减惩罚，所以千万要避开惩罚节点哦~"
  },
  "30001083": {
    "cn": "使用额外材料可对洗练产生额外效果~"
  },
  "30001084": {
    "cn": "点击这里可切换灵阵属性"
  },
  "30001085": {
    "cn": "同级不同属性的灵阵仅技能节点存在差异"
  },
  "30001086": {
    "cn": "道友可随时切换灵阵属性，不会影响当前已上阵的灵枢哦~"
  },
  "30001087": {
    "cn": "上阵的灵枢会受到节点提供的增幅加成"
  },
  "30001088": {
    "cn": "现在让我们研究节点获得更高的增幅吧~"
  },
  "30001089": {
    "cn": "八荒凶险，让小暖带领道友学习一些基本操作吧"
  },
  "30001090": {
    "cn": "前方有一个等待占领的据点，让我们率领弟子将它攻占下来吧！"
  },
  "30001091": {
    "cn": "勾选自动模式，即可自动进攻防守队列中的成员\n要注意对方弟子和自己出战弟子的差距哦！"
  },
  "30001092": {
    "cn": "点击此处加速行军"
  },
  "30001093": {
    "cn": "点击自动模式，即可自动攻打洞天啦。需要注意的是，自动模式仅在道友在线时有效"
  },
  "30001094": {
    "cn": "其它宗门的人也想来占领？没关系，消灭对方带领的全部弟子，就能送他回家了！"
  },
  "30001095": {
    "cn": "恭喜道友成功攻占了这个据点，它将持续为道友所在阵营产出灵液。越高阶的建筑产出的灵液越多。"
  },
  "30001096": {
    "cn": "您已完成了初步的新手引导，即将前往至真正的八荒战场征战，期待道友问鼎八荒！"
  },
  "30001097": {
    "cn": "在八荒中，消耗弟子可以获得战功，占领洞天可以获得宗门积分，这些都是能否取得好名次的关键。"
  },
  "30001098": {
    "cn": "道友还可以合成更高级的引魂香哦~"
  },
