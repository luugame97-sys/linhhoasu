  "30039000": {
    "cn": "窥探天机，洞察万物\n传说可以使人拥有看破虚妄的能力"
  },
  "30039001": {
    "cn": "神树生辉，好事成双\n听说早起的人运气会更好"
  },
  "30039002": {
    "cn": "聚沙成塔，滴水穿石\n掌握了些许奖励增加的权柄"
  },
  "30039003": {
    "cn": "长夜将至，明灯引归\n宫灯的光亮可为迷途的旅人指引方向"
  },
  "30039004": {
    "cn": "酒且斟下，某去便来\n武圣关羽温酒斩华雄时所使用的酒杯"
  },
  "30039005": {
    "cn": "岁月悠悠，天地同寿\n躬耕南野际守拙龟园田"
  },
  "30039006": {
    "cn": "炊金馔玉，列鼎而食\n治疗不如食疗"
  },
  "30039007": {
    "cn": "我是DJ喜羊羊，青青草原我最狂\n据说来自于被邪魔入侵后的神秘羊村"
  },
  "30039008": {
    "cn": "风云突变，神兽啸天\n每当大势有变时神兽会发出警示"
  },
  "30039009": {
    "cn": "道心清明,大智若愚\n这幅模样骗到了很多不明真相的妖邪"
  },
  "30039010": {
    "cn": "一饮一啄，莫非前定\n被第一缕日光照到时会有异象发生"
  },
  "30039011": {
    "cn": "风起寒角,钟意难平\n常年累月的敲打使得它尤为凝实"
  },
  "30039012": {
    "cn": "寻仙问道，难求长生\n跑的再快也无法快过时光"
  },
  "30039013": {
    "cn": "虎视鹰瞵，警钟长鸣\n上古大能包租婆曾用它打败火云邪神"
  },
  "30039014": {
    "cn": "苦修两载半，中分镇妖邪\n只因一出万兽皆服谁与争锋"
  },
  "30039015": {
    "cn": "古老邪修的传家之宝,长期血祭拥有了吸血的能力"
  },
  "30039016": {
    "cn": "手持双耳四处挥舞，总有概率触发反击"
  },
  "30039017": {
    "cn": "使用灵力御物快速投掷，即可打出连击"
  },
  "30039018": {
    "cn": "听说醉拳能显著提高闪避，干了这碗试试吧"
  },
  "30039019": {
    "cn": "手持圆柄方角向敌，即可打出漂亮的暴击"
  },
  "30039020": {
    "cn": "听什么风？台风！振聋发聩不过如是"
  },
  "30039021": {
    "cn": "当血管中流淌的不是血时，还会被吸血吗？"
  },
  "30039022": {
    "cn": "拥有它就离成为航海王的男人更近一步"
  },
  "30039023": {
    "cn": "化干戈为玉帛何尝不是一种缴械咒"
  },
  "30039024": {
    "cn": "深呼吸，头晕是正常的"
  },
  "30039025": {
    "cn": "提链壶并不能提炼任何东西"
  },
  "30039026": {
    "cn": "常年累月被用于敲门，再也不会被击晕了"
  },
  "30039027": {
    "cn": "你看这铜板儿它又长又宽"
  },
  "30039028": {
    "cn": "就像这铜钱儿它又大又圆"
  },
  "30039029": {
    "cn": "身体宽宽，头顶尖尖"
  },
  "30039030": {
    "cn": "万门可开，除了心门"
  },
  "30039031": {
    "cn": "据专家考证是古人吃冰激凌用的勺子"
  },
  "30039032": {
    "cn": "超古代灵魂提取器"
  },
  "30039033": {
    "cn": "没有把柄在他人手中"
  },
  "30039034": {
    "cn": "中土战争的导火索"
  },
  "30039035": {
    "cn": "活字印刷的最小单位"
  },
  "30039036": {
    "cn": "功夫再高，也怕菜刀"
  },
  "30039037": {
    "cn": "生命不息，滚动不止"
  },
  "30039038": {
    "cn": "铜铃一响，秘宝登场"
  },
  "30039039": {
    "cn": "聚沙成塔，滴水穿石\n掌握了些许奖励增加的权柄"
  },
  "30039040": {
    "cn": "种瓜得瓜种豆得豆，种红珊得什么？"
  },
  "30039041": {
    "cn": "红艳如焰岁月凝波光"
  },
  "30039042": {
    "cn": "如意如意随我心意快快显灵"
  },
  "30039043": {
    "cn": "仰天大笑出门去，归来倚杖自叹息"
  },
  "30039044": {
    "cn": "白练轻摇碧水中，银鱼翻跃出波纹"
  },
  "30039045": {
    "cn": "璀璨珍珠耳畔轻，夜风轻拂语含情"
  },
  "30039046": {
    "cn": "雪滴玉盘珠聚满，圆润温润如须弥"
  },
  "30039047": {
    "cn": "凤箫声动，玉壶光转，一夜鱼龙舞"
  },
  "30039048": {
    "cn": "清明笑语闻空虚，斗乘巨浪骑鲸鱼"
  },
  "30039049": {
    "cn": "千淘万漉虽辛苦，吹尽狂鲨始到金"
  },
  "30039050": {
    "cn": "蓬荜生光辉，沃地藏宝贝"
  },
  "30039051": {
    "cn": "今兹捧袂，喜托龙门\n参加宴会自当携厚礼入席"
  },
  "30039052": {
    "cn": "重要的不是我们所处的位置\n而是我们正朝向哪里"
  },
  "30039053": {
    "cn": "一直向西前进！直到我们回到起点"
  },
  "30039054": {
    "cn": "装着一艘被黄金诅咒的船"
  },
  "30039055": {
    "cn": "那时我还很瘦"
  },
  "30039056": {
    "cn": "它也能在海底旅行两万里吗"
  },
  "30039057": {
    "cn": "派小星我们去抓水母吧"
  },
  "30039058": {
    "cn": "传说是哥潭英雄使用的武器"
  },
  "30039059": {
    "cn": "鲤鱼跃龙门"
