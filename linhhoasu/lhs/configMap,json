  "30010526": {
    "cn": "合理搭配阵容是克敌制胜的秘诀哦~"
  },
  "30010527": {
    "cn": "消耗龙鳞可以对血脉进行精炼，获得精炼属性加成，精炼的<font color=#DC6200>星级越高</font>，属性<font color=#DC6200>数值越好</font>"
  },
  "30010528": {
    "cn": "若对当前精炼结果不满意，可在<font color=#DC6200>精炼满</font>后进行<font color=#DC6200>回退</font>，回退将移除未锁定的属性，回退<font color=#DC6200>不影响幸运值</font>，回退后可以<font color=#DC6200>重新进行精炼</font>"
  },
  "30010529": {
    "cn": "精炼<font color=#DC6200>星级</font>会影响血脉的<font color=#DC6200>品阶</font>，不同品质的血脉品阶上限不同，升阶所需要的精炼总星级也不同"
  },
  "30010530": {
    "cn": "可通过合成获得更高品质的血脉，合成成功将会<font color=#DC6200>继承</font>主血脉的<font color=#DC6200>精炼属性、精炼星级和幸运值</font>，并重新计算血脉品阶"
  },
  "30010531": {
    "cn": "合成出的血脉<font color=#DC6200>元素类型与投入的血脉</font>元素类型<font color=#DC6200>相关</font>，必定合出其中一种元素类型，不会合出未投入的元素类型"
  },
  "30010532": {
    "cn": "<font color=#DC6200>传说品质及以上</font>的血脉可以通过置换，随机获得一个其他同品质血脉，添加心愿单可以提高心愿血脉概率哦，置换后原血脉的<font color=#DC6200>精炼属性</font>和<font color=#DC6200>幸运值</font>会被<font color=#DC6200>继承</font>"
  },
  "30010533": {
