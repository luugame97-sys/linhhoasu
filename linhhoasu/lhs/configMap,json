  "30031361": {
    "cn": "风有约，花不误，山水万程皆奔赴，七夕渡，共赴长生路。"
  },
  "30031362": {
    "cn": "山无陵，江水为竭，冬雷震震，夏雨雪，天地合，乃敢与君绝！"
  },
  "30031363": {
    "cn": "以星为眸凝朝暮，以云为裳缀情愫，纵使三界倾覆，此爱不负。"
  },
  "30031364": {
    "cn": "九重天阙书盟誓，九幽地脉刻相思，轮回百次，仍识君姿。"
  },
  "30031365": {
    "cn": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。"
  },
  "30031366": {
    "cn": "死生契阔，与子成说。执子之手，与子偕老。"
  },
  "30031367": {
    "cn": "鹊桥织就相思网，星河盛满意难忘，一眼惊鸿，岁岁如常。"
  },
  "30031368": {
    "cn": "天不荒则爱不息，地不崩则情不止，江不涸则心相系，岩不碎则意不灭。"
  },
  "30031369": {
    "cn": "秉星辰以为契，告江海以为证，唤草木以为凭，仰先贤以为信。"
  },
  "30031370": {
    "cn": "在天愿作比翼鸟，在地愿为连理枝。"
  },
  "30031371": {
    "cn": "愿我如星君如月，夜夜流光相皎洁。"
  },
  "30031372": {
    "cn": "人生若只如初见，何事秋风悲画扇。"
  },
  "30031373": {
    "cn": "东边日出西边雨，道是无晴却有晴。"
  },
  "30031374": {
    "cn": "两情若是久长时，又岂在朝朝暮暮。"
  },
  "30031375": {
    "cn": "心中无爱人，拔刀自然神。"
